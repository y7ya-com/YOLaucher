index 00000000..12ae0b35
--- /dev/null
+++ b/project/emscripten/boxedwine-webgl-streaming.js
@@ -0,0 +1,79 @@
+// Small bufferSubData updates into a large WebGL buffer are very slow on ANGLE's Metal backend (Chrome on macOS):
+// while the GPU still uses the buffer, each update costs about a copy of the whole buffer. WineD3D streams vertices
+// into one 16 MB buffer with a tiny update per draw, so a D3D8 dialog screen with ~200 sprites spent ~250 ms per
+// frame waiting on the GPU. Route such updates through a small staging buffer and a GPU-side copyBufferSubData,
+// which is ordered like the original update (~17 ms per frame in the same pattern).
+(function() {
+    if (typeof WebGL2RenderingContext === 'undefined') {
+        return;
+    }
+    var P = WebGL2RenderingContext.prototype;
+    var LARGE_BUFFER = 1 << 20;
+    var MAX_UPDATE = 16 << 10;
+    var STAGE_SIZE = 64 << 10;
+    var sizes = new WeakMap();
+    var stages = new WeakMap();
+    var bufferData = P.bufferData;
+    var bufferSubData = P.bufferSubData;
+
+    function bindingOf(gl, target) {
+        switch (target) {
+            case gl.ARRAY_BUFFER: return gl.ARRAY_BUFFER_BINDING;
+            case gl.COPY_READ_BUFFER: return gl.COPY_READ_BUFFER_BINDING;
+            case gl.COPY_WRITE_BUFFER: return gl.COPY_WRITE_BUFFER_BINDING;
+            case gl.UNIFORM_BUFFER: return gl.UNIFORM_BUFFER_BINDING;
+            case gl.TRANSFORM_FEEDBACK_BUFFER: return gl.TRANSFORM_FEEDBACK_BUFFER_BINDING;
+        }
+        return 0;   // ELEMENT_ARRAY_BUFFER can't take a copy from a non-index buffer; pixel buffers stay as they are
+    }
+
+    function byteLength(data, srcOffset, length) {
+        if (typeof data === 'number') {
+            return data;
+        }
+        if (!data) {
+            return 0;
+        }
+        var element = data.BYTES_PER_ELEMENT || 1;
+        return length ? length * element : data.byteLength - (srcOffset || 0) * element;
+    }
+
+    P.bufferData = function(target, data, usage, srcOffset, length) {
+        var result = bufferData.apply(this, arguments);
+        var binding = bindingOf(this, target);
+        var buffer = binding && this.getParameter(binding);
+        if (buffer) {
+            sizes.set(buffer, byteLength(data, srcOffset, length));
+        }
+        return result;
+    };
+
+    P.bufferSubData = function(target, dstOffset, data, srcOffset, length) {
+        var binding = bindingOf(this, target);
+        var n = byteLength(data, srcOffset, length);
+        var buffer = binding && n <= MAX_UPDATE && this.getParameter(binding);
+        if (!buffer || (sizes.get(buffer) || 0) < LARGE_BUFFER) {
+            return bufferSubData.apply(this, arguments);
+        }
+        var stageTarget = target === this.COPY_READ_BUFFER ? this.COPY_WRITE_BUFFER : this.COPY_READ_BUFFER;
+        var previous = this.getParameter(bindingOf(this, stageTarget));
+        var stage = stages.get(this);
+        if (!stage) {
+            stage = {buffer: this.createBuffer(), offset: STAGE_SIZE};
+            stages.set(this, stage);
+        }
+        this.bindBuffer(stageTarget, stage.buffer);
+        if (stage.offset + n > STAGE_SIZE) {
+            bufferData.call(this, stageTarget, STAGE_SIZE, this.STREAM_DRAW);
+            stage.offset = 0;
+        }
+        if (arguments.length > 3) {
+            bufferSubData.call(this, stageTarget, stage.offset, data, srcOffset, length);
+        } else {
+            bufferSubData.call(this, stageTarget, stage.offset, data);
+        }
+        this.copyBufferSubData(stageTarget, target, stage.offset, dstOffset, n);
+        stage.offset += (n + 15) & ~15;
+        this.bindBuffer(stageTarget, previous);
+    };
+})();
