+U32 present(CPU* cpu) {
+    Dev* d = dev;
+    if (!onGlThread()) { kwarn("d3dnative: Present off the GL thread"); return D3D_OK; }
+    flush();
+    int dw = 0, dh = 0;
+    emscripten_webgl_get_drawing_buffer_size(d->ctx, &dw, &dh);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, d->backBuffer->fbo);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(1, 1, 1, 1);
+    glBlitFramebuffer(0, 0, d->bbW, d->bbH, 0, dh, dw, 0, GL_COLOR_BUFFER_BIT, dw == (int)d->bbW && dh == (int)d->bbH ? GL_NEAREST : GL_LINEAR);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0);   // the guest's SwapBuffers reads the default framebuffer
+    glViewport(0, 0, dw, dh);               // and takes its size from the viewport when unsure
+    if (!deadTextures.empty()) { glDeleteTextures((GLsizei)deadTextures.size(), deadTextures.data()); deadTextures.clear(); }
+    if (!deadFbos.empty()) { glDeleteFramebuffers((GLsizei)deadFbos.size(), deadFbos.data()); deadFbos.clear(); }
+    if (!deadRenderbuffers.empty()) { glDeleteRenderbuffers((GLsizei)deadRenderbuffers.size(), deadRenderbuffers.data()); deadRenderbuffers.clear(); }
+    frames++;
+    logStats();
+    return D3D_OK;
+}
