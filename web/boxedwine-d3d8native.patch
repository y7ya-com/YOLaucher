+        if (dev && dev->texture == t && !(flags & LOCK_READONLY) && onGlThread()) flush();   // queued draws see the old texels
+        int r[4];
+        U32 hr = lockLevel(l.shadow, l.w, l.h, A(3), A(4), r);
+        if (hr) return hr;   // render targets have no shadow: not lockable, as in D3D8
+        l.locked = true;
+        if (!(flags & LOCK_READONLY)) addDirty(l, r);
+        return D3D_OK;
+    }
+    case 17: {                                                         // UnlockRect
+        U32 i = A(2);
+        if (i >= t->levels.size() || !t->levels[i].locked) return D3DERR_INVALIDCALL;
+        t->levels[i].locked = false;
+        return D3D_OK;
+    }
+    case 18: for (Level& l : t->levels) { int r[4] = {0, 0, (int)l.w, (int)l.h}; addDirty(l, r); } return D3D_OK;   // AddDirtyRect
+    }
+    return unsupported(IF_TEX, slot);
+}
+
+U32 callSurf(CPU* cpu, Surf* s, U32 slot) {
+    switch (slot) {
+    case 3: if (!A(2)) return D3DERR_INVALIDCALL; addRef(dev); wr(A(2), dev->guest); return D3D_OK;   // GetDevice
+    case 4: case 6: return D3D_OK;
+    case 5: return D3DERR_NOTAVAILABLE;
+    case 7: {                                                          // GetContainer
+        U32 out = A(3);
+        if (!out) return D3DERR_INVALIDCALL;
+        if (s->owner) { addRef(s->owner); wr(out, s->owner->guest); return D3D_OK; }
+        addRef(dev); wr(out, dev->guest); return D3D_OK;               // standalone surfaces belong to the device
+    }
+    case 8: return writeSurfaceDesc(A(2), s->fmt, RTYPE_SURFACE, s->usage, s->pool, s->w, s->h);   // GetDesc
+    case 9: {                                                          // LockRect
+        U32 flags = A(4);
+        if (s->owner) {
+            Tex* t = s->owner;
+            Level& l = t->levels[s->level];
+            if (l.locked) return D3DERR_INVALIDCALL;
+            if (dev && dev->texture == t && !(flags & LOCK_READONLY) && onGlThread()) flush();
+            int r[4];
+            U32 hr = lockLevel(l.shadow, l.w, l.h, A(2), A(3), r);
+            if (hr) return hr;
+            l.locked = true;
+            if (!(flags & LOCK_READONLY)) addDirty(l, r);
+            return D3D_OK;
+        }
+        int r[4];
+        U32 hr = lockLevel(s->shadow, s->w, s->h, A(2), A(3), r);
+        if (hr && !s->shadow) kwarn("d3dnative: LockRect on a GPU surface (back buffer/depth) is not supported");
+        return hr;
+    }
+    case 10:                                                           // UnlockRect
+        if (s->owner) s->owner->levels[s->level].locked = false;
+        return D3D_OK;
+    }
+    return unsupported(IF_SURF, slot);
+}
+
+// d3dInit(arenaBase, arenaSize, guestCreateDevice, guestPresent): writes thunks and vtables, returns an IDirect3D8*
+U32 init(CPU* cpu) {
+    if (arenaBase) { kwarn("d3dnative: Direct3DCreate8 called twice; reusing the arena"); }
+    else {
+        arenaBase = A(1); arenaSize = A(2); arenaTop = arenaBase + 0x4000;
+        U8 code[16] = {0xcd, 0x99};
+        for (int i = 0; i < IF_COUNT; i++) {
+            for (U32 s = 0; s < kSlots[i]; s++) {
+                U32 index = 0x0D3D0000 | i << 8 | s;
+                memcpy(code + 2, &index, 4);
+                code[6] = 0xc2;                    // ret imm16
+                U16 n = kMethods[i][s].argBytes;
+                memcpy(code + 7, &n, 2);
+                cpu->memory->memcpy(thunkAddr(i, s), code, 16);
+                wr(vtableAddr(i) + s * 4, thunkAddr(i, s));
+            }
+        }
+        if (A(3)) wr(vtableAddr(IF_D3D) + 15 * 4, A(3));   // the guest's CreateDevice makes the GL context first
+        if (A(4)) wr(vtableAddr(IF_DEV) + 15 * 4, A(4));   // the guest's Present swaps after ours
+        klog_fmt("d3dnative: arena 0x%08x, %u MB", arenaBase, arenaSize >> 20);
+    }
+    D3D* d = new D3D;
+    return newGuest(d, IF_D3D);
+}
+
+}  // namespace
+
+void d3dNativeCall(CPU* cpu, U32 index) {
+    std::lock_guard<std::recursive_mutex> guard(lock);
+    gcpu = cpu;
+    U32 iface = index >> 8 & 0xff, slot = index & 0xff;
+    if (iface == IF_GLOBAL) {
+        EAX = slot == 0 ? init(cpu) : 0;
+        return;
+    }
+    if (iface >= IF_COUNT || slot >= kSlots[iface]) { EAX = D3DERR_INVALIDCALL; return; }
+    calls[iface][slot]++;
+    Obj* o = fromGuest(A(1), (int)iface);
+    if (!o) {
+        kwarn_fmt("d3dnative: %s::%s on a bad object 0x%08x", kIfName[iface], kMethods[iface][slot].name, A(1));
+        EAX = D3DERR_INVALIDCALL;
+        return;
+    }
+    switch (slot) {
+    case 0: {   // QueryInterface. ponytail: every interface asked for is answered with the object itself (the D3D8
+                // base interfaces are prefixes of these vtables)
+        U32 out = A(3);
+        if (!out) { EAX = E_NOINTERFACE; return; }
+        addRef(o);
+        wr(out, o->guest);
+        EAX = D3D_OK;
+        return;
+    }
+    case 1: EAX = addRef(o); return;
+    case 2: EAX = release(o); return;
+    }
+    switch (iface) {
+    case IF_D3D: EAX = callD3D(cpu, (D3D*)o, slot); break;
+    case IF_DEV: EAX = callDev(cpu, (Dev*)o, slot); break;
+    case IF_TEX: EAX = callTex(cpu, (Tex*)o, slot); break;
+    case IF_SURF: EAX = callSurf(cpu, (Surf*)o, slot); break;
+    }
+}
+
+#else
+void d3dNativeCall(CPU* cpu, U32 index) {
+    kpanic_fmt("d3dnative: native D3D8 needs the Emscripten WebGL build (call 0x%x)", index);
+}
+#endif
