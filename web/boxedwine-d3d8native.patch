+U32 clear(CPU* cpu) {
+    Dev* d = dev;
+    U32 count = A(2), rects = A(3), flags = A(4), c = A(5), stencil = A(7);
+    float z;
+    U32 zb = A(6);
+    memcpy(&z, &zb, 4);
+    if (!onGlThread()) return D3DERR_INVALIDCALL;
+    flush();
+    GLbitfield mask = 0;
+    if (flags & CLEAR_TARGET) {
+        float f[4];
+        color4(c, f);
+        glClearColor(f[0], f[1], f[2], d->target->fmt == FMT_X8R8G8B8 ? 1.f : f[3]);   // X8 has no alpha: keep it 1
+        glColorMask(1, 1, 1, 1);
+        mask |= GL_COLOR_BUFFER_BIT;
+    }
+    if ((flags & CLEAR_ZBUFFER) && d->depth) { glClearDepthf(z); glDepthMask(1); mask |= GL_DEPTH_BUFFER_BIT; }
+    if ((flags & CLEAR_STENCIL) && d->depth) { glClearStencil((GLint)stencil); glStencilMask(0xff); mask |= GL_STENCIL_BUFFER_BIT; }
+    if (!mask) return D3D_OK;
+    glUseProgram(d->program);
+    bindTarget();
+    glEnable(GL_SCISSOR_TEST);   // D3D clears only the viewport (and the rects inside it)
+    for (U32 i = 0; i < (rects ? count : 1); i++) {
+        int x0 = d->vp[0], y0 = d->vp[1], x1 = d->vp[0] + d->vp[2], y1 = d->vp[1] + d->vp[3];
+        if (rects) {
+            U32 r = rects + i * 16;
+            x0 = std::max(x0, (int)rd(r)); y0 = std::max(y0, (int)rd(r + 4));
+            x1 = std::min(x1, (int)rd(r + 8)); y1 = std::min(y1, (int)rd(r + 12));
+        }
+        if (x1 <= x0 || y1 <= y0) continue;
+        glScissor(x0, y0, x1 - x0, y1 - y0);   // top-first storage: D3D rows are GL rows
+        glClear(mask);
+    }
+    glDisable(GL_SCISSOR_TEST);
+    return D3D_OK;
+}
+
+U32 drawPrimitiveUP(CPU* cpu) {
+    Dev* d = dev;
+    U32 type = A(2), count = A(3), v = A(4), stride = A(5);
+    U32 fvf = d->fvf;
+    bool hasColor = fvf & FVF_DIFFUSE;
+    U32 texCount = fvf >> 8 & 0xf;
+    U32 need = 12 + (hasColor ? 4 : 0) + (texCount ? 8 : 0);
+    if (!v || !count || (fvf & 0xe) != FVF_XYZ || stride < need || (type != 4 && type != 5 && type != 6)) {
+        if (!loggedUnsupported[IF_DEV][72]) {
+            loggedUnsupported[IF_DEV][72] = true;
+            kwarn_fmt("d3dnative: unsupported DrawPrimitiveUP type %u fvf 0x%x stride %u", type, fvf, stride);
+        }
+        return D3DERR_INVALIDCALL;
+    }
+    if (!onGlThread()) return D3DERR_INVALIDCALL;
+    U32 n = type == 4 ? count * 3 : count + 2;
+    static std::vector<U8> raw;
+    raw.resize((size_t)n * stride);
+    gcpu->memory->memcpy(raw.data(), v, n * stride);
+    static std::vector<Vertex> verts;
+    verts.resize(n);
+    const Matrix& w = d->world;
+    for (U32 i = 0; i < n; i++) {
+        const U8* p = raw.data() + (size_t)i * stride;
+        float x, y, z;
+        memcpy(&x, p, 4); memcpy(&y, p + 4, 4); memcpy(&z, p + 8, 4);
+        Vertex& o = verts[i];
+        float ww = x * w.m[0][3] + y * w.m[1][3] + z * w.m[2][3] + w.m[3][3];
+        float inv = ww != 0 && ww != 1 ? 1.f / ww : 1.f;   // ponytail: a projective world matrix divides early
+        o.x = (x * w.m[0][0] + y * w.m[1][0] + z * w.m[2][0] + w.m[3][0]) * inv;
+        o.y = (x * w.m[0][1] + y * w.m[1][1] + z * w.m[2][1] + w.m[3][1]) * inv;
+        o.z = (x * w.m[0][2] + y * w.m[1][2] + z * w.m[2][2] + w.m[3][2]) * inv;
+        U32 c = 0;
+        if (hasColor) memcpy(&c, p + 12, 4);
+        lit(c, hasColor, o.c);
+        if (texCount) { memcpy(&o.u, p + need - 8, 4); memcpy(&o.v, p + need - 4, 4); }
+        else o.u = o.v = 0;
+    }
+    std::vector<Vertex>& b = d->batch;
+    if (type == 4) {
+        b.insert(b.end(), verts.begin(), verts.end());
+    } else {
+        for (U32 i = 0; i < count; i++) {
+            if (type == 5) {   // strip: keep the winding of odd triangles
+                b.push_back(verts[i + (i & 1)]); b.push_back(verts[i + 1 - (i & 1)]); b.push_back(verts[i + 2]);
+            } else {           // fan
+                b.push_back(verts[0]); b.push_back(verts[i + 1]); b.push_back(verts[i + 2]);
+            }
+        }
+    }
+    prims++;
+    return D3D_OK;
+}
+
+U32 setTransform(CPU* cpu, bool multiply) {
+    U32 state = A(2), p = A(3);
+    if (!p) return D3DERR_INVALIDCALL;
+    Matrix m;
+    for (int i = 0; i < 16; i++) m.m[i / 4][i % 4] = rdf(p + i * 4);
+    Matrix* t = state == TS_WORLD ? &dev->world : state == TS_VIEW ? &dev->view : state == TS_PROJECTION ? &dev->proj : nullptr;
+    if (!t) return D3D_OK;   // texture transforms: accepted and ignored (TEXTURETRANSFORMFLAGS is never set)
+    if (multiply) m = mul(m, *t);
+    if (t != &dev->world && memcmp(t, &m, sizeof m)) flush();   // the world matrix is baked per vertex
+    *t = m;
+    return D3D_OK;
+}
+
+U32 getSurfaceRef(Surf* s, U32 out) {
+    if (!out) return D3DERR_INVALIDCALL;
+    wr(out, s ? s->guest : 0);
+    if (!s) return D3DERR_NOTAVAILABLE;
+    addRef(s);
+    return D3D_OK;
+}
+
+// A surface's CPU pixels: image surfaces and texture levels (guest B,G,R,A rows, pitch w*4)
+U32 shadowOf(Surf* s) { return s->owner ? s->owner->levels[s->level].shadow : s->shadow; }
+
+// CopyRects(src, rects, count, dst, points): CPU copies between surfaces with pixels in guest memory; the back buffer
+// (or a render-target texture) as the source is read back first.
+U32 copyRects(CPU* cpu) {
+    Surf* src = (Surf*)fromGuest(A(2), IF_SURF);
+    Surf* dst = (Surf*)fromGuest(A(5), IF_SURF);
+    U32 rects = A(3), count = A(4), points = A(6);
+    U32 dstBits = dst ? shadowOf(dst) : 0;
+    if (!src || !dst || !dstBits)   // both formats are 32-bit B,G,R,A(X)
+        return D3DERR_INVALIDCALL;
+    std::vector<U8> pixels((size_t)src->w * src->h * 4);
+    if (U32 bits = shadowOf(src)) {
+        gcpu->memory->memcpy(pixels.data(), bits, (U32)pixels.size());
+    } else {
+        if (!onGlThread()) return D3DERR_INVALIDCALL;
+        flush();
+        if (src->owner) { syncTexture(src->owner); if (!src->owner->fbo) glGenFramebuffers(1, &src->owner->fbo); }
+        glBindFramebuffer(GL_FRAMEBUFFER, src->owner ? src->owner->fbo : src->fbo);
+        if (src->owner) glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, src->owner->tex, src->level);
+        glPixelStorei(GL_PACK_ALIGNMENT, 4);
+        glReadPixels(0, 0, src->w, src->h, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());   // rows already top first
+        for (size_t i = 0; i < pixels.size(); i += 4) std::swap(pixels[i], pixels[i + 2]);   // to B,G,R,A
+        bindTarget();
+    }
+    U32 n = rects ? count : 1;
+    for (U32 i = 0; i < n; i++) {
+        int x0 = 0, y0 = 0, x1 = src->w, y1 = src->h;
+        if (rects) { x0 = rd(rects + i * 16); y0 = rd(rects + i * 16 + 4); x1 = rd(rects + i * 16 + 8); y1 = rd(rects + i * 16 + 12); }
+        int dx = points ? (int)rd(points + i * 8) : x0, dy = points ? (int)rd(points + i * 8 + 4) : y0;
+        if (x0 < 0 || y0 < 0 || x1 > (int)src->w || y1 > (int)src->h || x0 >= x1 || y0 >= y1 ||
+            dx < 0 || dy < 0 || dx + (x1 - x0) > (int)dst->w || dy + (y1 - y0) > (int)dst->h)
+            return D3DERR_INVALIDCALL;
+        for (int y = y0; y < y1; y++)
+            gcpu->memory->memcpy(dstBits + ((dy + y - y0) * dst->w + dx) * 4, pixels.data() + ((size_t)y * src->w + x0) * 4, (x1 - x0) * 4);
+        if (dst->owner) {
+            if (dev->texture == dst->owner && onGlThread()) flush();
+            int r[4] = {dx, dy, dx + (x1 - x0), dy + (y1 - y0)};
+            addDirty(dst->owner->levels[dst->level], r);
+        }
+    }
+    return D3D_OK;
+}
