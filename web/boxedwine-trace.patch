+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+// Code-coverage trace (diagnostic, only with &trace=1 in the page URL): the first decode of every block that starts in
+// yo2.exe's .text stores the page's current phase number there (0 = never ran). The page sets the phase and reads the
+// map with bwTraceMark()/bwTraceDump() (boxedwine-shell.js). A block decodes once, so this costs nothing per run.
+#define BW_TRACE_LO 0x401000
+#define BW_TRACE_HI 0xbe5000
+static U8 bwTraceMap[BW_TRACE_HI - BW_TRACE_LO];
+static volatile U8 bwTracePhase;   // 0 = trace off
+extern "C" EMSCRIPTEN_KEEPALIVE U32 bw_trace_map() { return (U32)(uintptr_t)bwTraceMap; }
+extern "C" EMSCRIPTEN_KEEPALIVE U32 bw_trace_phase() { return (U32)(uintptr_t)&bwTracePhase; }
+static void bwTraceBlock(KThread* thread, U32 eip) {
+    U8 phase = bwTracePhase;
+    if (!phase || eip < BW_TRACE_LO || eip >= BW_TRACE_HI || bwTraceMap[eip - BW_TRACE_LO]) return;
+    if (thread->process && thread->process->name.endsWith("yo2.exe", true)) bwTraceMap[eip - BW_TRACE_LO] = phase;
+}
+#else
+static void bwTraceBlock(KThread*, U32) {}
+#endif
