+
+// Code-coverage trace (only with &trace=1): every block of yo2.exe's .text records the phase it first ran in
+// (normalCPU.cpp). bwTraceMark(n) starts phase n (1-255; phase 1 is on from boot); bwTraceDump() returns
+// "addr:phase" hex pairs for every block that ran.
+if (typeof window !== "undefined" && /[?&]trace=1(&|$)/.test(location.search)) {
+  var bwTraceHeap = function() { return Module.HEAPU8 || HEAPU8; };
+  window.bwTraceMark = function(n) { bwTraceHeap()[Module._bw_trace_phase()] = n; };
+  window.bwTraceDump = function() {
+    var map = bwTraceHeap().subarray(Module._bw_trace_map(), Module._bw_trace_map() + (0xbe5000 - 0x401000));
+    var out = [];
+    for (var i = 0; i < map.length; i++) {
+      if (map[i]) out.push((0x401000 + i).toString(16) + ":" + map[i].toString(16));
+    }
+    return out.join(",");
+  };
+  var bwTraceStart = setInterval(function() {
+    if (!Module._bw_trace_phase || !bwTraceHeap()) return;
+    clearInterval(bwTraceStart);
+    if (!bwTraceHeap()[Module._bw_trace_phase()]) window.bwTraceMark(1);
+    console.log("BWTRACE on (bwTraceMark(n), bwTraceDump())");
+  }, 200);
+}
